# ============================================================
# Khoj — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Public (exposed to browser) ----------------------------
NEXT_PUBLIC_APP_NAME="Khoj"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CAMPUS_NAME="Community"
# NEXT_PUBLIC_SUPPORT_EMAIL="support@khoj.app"

# ---- Database (Neon PostgreSQL) -----------------------------
# Runtime queries
DATABASE_URL=""
# Direct connection for migrations
DIRECT_URL=""

# ---- Better Auth --------------------------------------------
# Generate a strong random secret: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Dedicated keyed HMAC-SHA256 secret for OTP hashing (min 32 chars): openssl rand -hex 32
OTP_HASH_SECRET=""
# Public URL of this application (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# ---- Gmail SMTP (port 587 + STARTTLS) -----------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
# Use a Gmail App Password, not your account password
SMTP_PASS=""
EMAIL_FROM="noreply@khoj.app"
